# Generate a random 32-byte secret. Keep this private and stable.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Your existing MONGO_URL in .env can also be used.
MONGO_URL=
MONGO_DB_NAME=next_auth

# Google OAuth Web client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth app
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
